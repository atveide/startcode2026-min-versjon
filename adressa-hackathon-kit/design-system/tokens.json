{
  "meta": {
    "name": "Adressa Hackathon Design System",
    "version": "1.0.0",
    "status": "unofficial",
    "date": "2026-10-15",
    "sourceNote": "Kun tokenene merket observed er observert i offentlig nettsted-CSS. Alle øvrige verdier og regler er forslag for hackathon."
  },
  "color": {
    "brand": {
      "$type": "color",
      "$value": "#005379",
      "$description": "Primærhandlinger og avsender. Observert som --color-primary på adressa.no.",
      "$origin": "observed"
    },
    "brand-hover": {
      "$type": "color",
      "$value": "#003E5B",
      "$description": "Hover/pressed for primærhandling.",
      "$origin": "proposed"
    },
    "brand-soft": {
      "$type": "color",
      "$value": "#E9F4F8",
      "$description": "Rolige markeringer og aktive kategorier.",
      "$origin": "proposed"
    },
    "accent": {
      "$type": "color",
      "$value": "#28AAE2",
      "$description": "Sekundær aksent; dekorativ bruk. Observert som --color-secondary.",
      "$origin": "observed"
    },
    "ink": {
      "$type": "color",
      "$value": "#17212B",
      "$description": "Hovedtekst.",
      "$origin": "proposed"
    },
    "muted": {
      "$type": "color",
      "$value": "#53616E",
      "$description": "Sekundærtekst med lesbar kontrast.",
      "$origin": "proposed"
    },
    "paper": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Artikkelflate og navigasjon.",
      "$origin": "proposed"
    },
    "canvas": {
      "$type": "color",
      "$value": "#F4F5F2",
      "$description": "Bakgrunn utenfor leseflaten.",
      "$origin": "proposed"
    },
    "border": {
      "$type": "color",
      "$value": "#D6DCE0",
      "$description": "Dekorative skillelinjer, ikke eneste kontrollgrense.",
      "$origin": "proposed"
    },
    "live": {
      "$type": "color",
      "$value": "#B42318",
      "$description": "Siste nytt/feil; bruk alltid tekst eller symbol sammen med fargen.",
      "$origin": "proposed"
    },
    "success": {
      "$type": "color",
      "$value": "#17734E",
      "$description": "Bekreftelse og lagret-status.",
      "$origin": "proposed"
    },
    "sport": {
      "$type": "color",
      "$value": "#4E9D2D",
      "$description": "Observert kategoriaksent. Ikke liten tekst på hvitt.",
      "$origin": "observed"
    },
    "culture": {
      "$type": "color",
      "$value": "#C3002F",
      "$description": "Observert kulturaksent.",
      "$origin": "observed"
    },
    "focus": {
      "$type": "color",
      "$value": "#005379",
      "$description": "Fokusring på lyse flater.",
      "$origin": "proposed"
    },
    "on-brand": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Tekst på primærfargen.",
      "$origin": "proposed"
    }
  },
  "font": {
    "editorial": {
      "$type": "fontFamily",
      "$value": "'Bitter', Georgia, serif",
      "$origin": "proposed"
    },
    "ui": {
      "$type": "fontFamily",
      "$value": "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "$origin": "proposed"
    }
  },
  "space": {
