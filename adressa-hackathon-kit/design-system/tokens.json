    "11": {
      "$type": "dimension",
      "$value": "44px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "13": {
      "$type": "dimension",
      "$value": "52px"
    },
    "14": {
      "$type": "dimension",
      "$value": "56px"
    },
    "15": {
      "$type": "dimension",
      "$value": "60px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
