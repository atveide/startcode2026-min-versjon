  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "size": {
    "touch": {
      "$type": "dimension",
      "$value": "44px"
    },
    "content": {
      "$type": "dimension",
      "$value": "1200px"
    },
    "reading": {
      "$type": "dimension",
      "$value": "680px"
    },
    "sidebar": {
      "$type": "dimension",
      "$value": "288px"
    }
  },
  "type": {
    "caption": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "small": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "body": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "reading": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "card": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "section": {
      "$type": "dimension",
      "$value": "1.75rem"
    },
    "headline": {
      "$type": "dimension",
      "$value": "clamp(2rem, 4.2vw, 3.5rem)"
    },
    "display": {
      "$type": "dimension",
      "$value": "clamp(2.5rem, 5vw, 4.5rem)"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "120ms"
    },
    "normal": {
      "$type": "duration",
      "$value": "180ms"
    }
  },
  "dark": {
    "brand": "#83C9ED",
    "brand-hover": "#AFDEF5",
    "brand-soft": "#14384B",
    "accent": "#5DC1F0",
    "ink": "#ECF0F3",
    "muted": "#ADBCC6",
    "paper": "#15212B",
    "canvas": "#0F1820",
    "border": "#344550",
    "live": "#FFABA4",
    "success": "#7ED6AA",
    "focus": "#83C9ED",
    "on-brand": "#0F1820"
  }
}
