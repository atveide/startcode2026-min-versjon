<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Backend the app talks to. Same server the Netlify site proxies /api to.
	     To test against your own machine, put its address here (e.g. http://192.168.1.20:8000)
	     or set OPPLYST_API_BASE in the scheme's environment variables. -->
	<key>OpplystAPIBase</key>
	<string>https://startcode-august-api.onrender.com</string>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- Opplyst is dark only and portrait only, like the web app. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- HTTPS everywhere, but allow a backend on the local network for development. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
