*.egg-info/

# Node
node_modules/
dist/

# Local data
*.db

# Env / editor
.env
.env.local
.DS_Store
.idea/
.vscode/

# Netlify CLI
.netlify/

# The old personal unlock links, from before the site password; never commit them.
frontend/.reader*
# A local copy of the site password (Netlify's SITE_PASSWORD); never commit it.
frontend/.site-password
# Acta and Stag have no open license (see public/assets/licenses/), so they stay out of this public
# repo; the hosted frontend gets them from the local build. Roboto (Apache 2.0) is in git.
frontend/public/assets/fonts/acta_*.woff2
frontend/public/assets/fonts/Stag-*.otf

# Xcode
ios/build/
ios/DerivedData/
xcuserdata/
*.xcuserstate

# Imported videos (originals, web copies, posters); public metadata is in backend/app/data/videos.json
backend/media/
# The scraper's Adressa cache: article text and photos from the subscription (python -m app.scraper)
backend/cache/
