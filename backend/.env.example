APP_NAME=Backend
CORS_ORIGINS=["http://localhost:5173"]
ANTHROPIC_API_KEY=

# The scraper's Adressa cache: articles.json and images/ (python -m app.scraper), never committed
ADRESSA_CACHE_DIR=cache/adressa
# The scraper's browser profile with the saved Adressa login (make adressa-login). Outside the repo.
# ADRESSA_PROFILE_DIR=~/Library/Application Support/opplyst/adressa-profile

# The model for Opplyst's short versions of the stories (python -m app.summaries)
SUMMARY_MODEL=claude-sonnet-5-5

# Imported videos (python -m app.import_videos); git-ignored
VIDEO_MEDIA_DIR=media/videos
